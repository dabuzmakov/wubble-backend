# Быстрая ручная проверка auth-эндпоинтов из Visual Studio / Rider.
# Письмо с подтверждением смотреть в Mailpit: http://localhost:8025
# Access-токен взять из cookie wubble_access в ответе login и вставить ниже.

@host = https://localhost:7051
@accessToken = paste-access-token-here

GET {{host}}/api/health/
Accept: application/json

###

POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "username": "tester",
  "password": "password123"
}

###

POST {{host}}/api/auth/verify-email
Content-Type: application/json

{
  "userId": "00000000-0000-0000-0000-000000000000",
  "token": "token-from-email-link"
}

###

POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123"
}

###

GET {{host}}/api/auth/me
Authorization: Bearer {{accessToken}}

###
